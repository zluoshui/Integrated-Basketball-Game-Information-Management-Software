<Window x:Class="BasketballManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="篮球积分及球员信息综合管理系统"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="160" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl>
            <TabItem Header="赛事管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="赛事名" />
                        <TextBox x:Name="CompetitionNameBox" Width="180" />
                        <TextBlock Text="赛事 ID" />
                        <TextBox x:Name="CompetitionIdBox" Width="150" />
                        <TextBlock Text="已导入赛事" />
                        <ComboBox x:Name="CompetitionListCombo" Width="220" DisplayMemberPath="Manifest.Name" SelectionChanged="CompetitionListCombo_SelectionChanged" />
                        <Button Content="创建赛事" Click="CreateCompetition_Click" />
                        <Button Content="导入赛事" Click="ImportCompetition_Click" />
                        <Button Content="切换到选中赛事" Click="SwitchCompetition_Click" />
                        <Button Content="保存赛事信息" Click="SaveCompetition_Click" />
                        <Button Content="导出当前赛事目录" Click="ExportCompetition_Click" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1"
                               x:Name="CompetitionPathText"
                               Text="赛事目录："
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>

            <TabItem Header="球员管理">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="姓名" />
                        <TextBox x:Name="PlayerNameBox" />
                        <TextBlock Text="学号" />
                        <TextBox x:Name="StudentNumberBox" />
                        <TextBlock Text="队伍" />
                        <ComboBox x:Name="PlayerTeamCombo" Width="130" DisplayMemberPath="DisplayName" />
                        <TextBlock Text="状态" />
                        <ComboBox x:Name="PlayerStatusCombo" Width="90" />
                        <TextBlock Text="备注" />
                        <TextBox x:Name="PlayerNoteBox" Width="180" />
                        <TextBlock Text="照片" />
                        <TextBox x:Name="PhotoPathBox" Width="190" IsReadOnly="True" />
                        <Button Content="选择照片" Click="SelectPhoto_Click" />
                        <Button Content="新增/保存球员" Click="SavePlayer_Click" />
                        <Button Content="新建球员" Click="NewPlayer_Click" />
                        <Button Content="删除球员" Click="DeletePlayer_Click" />
                        <Button Content="备份数据" Click="BackupData_Click" />
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBlock Text="搜索" />
                            <TextBox x:Name="PlayerSearchBox" Width="220" TextChanged="PlayerSearchBox_TextChanged" />
                            <TextBlock Text="自定义字段" />
                            <TextBox x:Name="CustomFieldNameBox" Width="140" />
                            <TextBlock Text="当前球员字段值" />
                            <TextBox x:Name="CustomFieldValueBox" Width="180" />
                            <Button Content="保存字段和值" Click="SaveCustomField_Click" />
                        </WrapPanel>
                        <DataGrid x:Name="PlayersGrid"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="PlayersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="学号" Binding="{Binding StudentNumber}" Width="*" />
                                <DataGridTextColumn Header="队伍" Binding="{Binding Team}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="2*" />
                                <DataGridTextColumn Header="照片路径" Binding="{Binding PhotoPath}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#DDD" BorderThickness="1" Height="150" Margin="0,0,0,8">
                                <Grid>
                                    <Image x:Name="PhotoPreview" Stretch="Uniform" />
                                    <TextBlock x:Name="PhotoPreviewStatus"
                                               Text="无照片"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#666" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="自定义字段值" FontWeight="Bold" />
                            <DataGrid x:Name="CustomFieldsGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="比赛准备">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <TextBlock Text="队伍名" />
                        <TextBox x:Name="TeamNameBox" Width="140" />
                        <TextBlock Text="队伍备注" />
                        <TextBox x:Name="TeamNoteBox" Width="180" />
                        <Button Content="新增/保存队伍" Click="SaveTeam_Click" />
                        <Button Content="停用队伍" Click="DisableTeam_Click" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="比赛名" />
                        <TextBox x:Name="MatchNameBox" Width="180" />
                        <TextBlock Text="主队" />
                        <ComboBox x:Name="HomeTeamCombo" DisplayMemberPath="DisplayName" Width="150" />
                        <TextBlock Text="客队" />
                        <ComboBox x:Name="AwayTeamCombo" DisplayMemberPath="DisplayName" Width="150" />
                        <TextBlock Text="日期" />
                        <TextBox x:Name="MatchDateBox" Width="110" />
                        <TextBlock Text="地点" />
                        <TextBox x:Name="MatchLocationBox" Width="120" />
                        <TextBlock Text="备注" />
                        <TextBox x:Name="MatchNoteBox" Width="160" />
                        <TextBlock Text="节数" />
                        <TextBox x:Name="PeriodCountBox" Width="50" Text="4" />
                        <TextBlock Text="每节分钟" />
                        <TextBox x:Name="PeriodLengthBox" Width="80" Text="10" />
                        <Button Content="创建比赛" Click="CreateMatch_Click" />
                        <TextBlock Text="准备比赛" />
                        <ComboBox x:Name="MatchCombo" DisplayMemberPath="DisplayName" SelectionChanged="MatchCombo_SelectionChanged" Width="280" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,8">
                        <TextBlock Text="球员" />
                        <ComboBox x:Name="RosterPlayerCombo" DisplayMemberPath="DisplayName" Width="220" />
                        <TextBlock Text="阵营" />
                        <ComboBox x:Name="RosterSideCombo" Width="100" />
                        <TextBlock Text="号码" />
                        <TextBox x:Name="JerseyNumberBox" Width="70" />
                        <CheckBox x:Name="StarterBox" Content="首发" Margin="8,4" VerticalAlignment="Center" />
                        <Button Content="加入名单" Click="AddRoster_Click" />
                        <Button Content="更新名单" Click="UpdateRoster_Click" />
                        <Button Content="移出名单" Click="RemoveRoster_Click" />
                        <TextBlock Text="审计操作人" />
                        <TextBox x:Name="RosterAuditOperatorBox" Width="110" />
                        <TextBlock Text="审计备注" />
                        <TextBox x:Name="RosterAuditNoteBox" Width="180" />
                    </WrapPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid x:Name="TeamsGrid"
                                  Grid.Column="0"
                                  Margin="0,0,8,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="TeamsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="队伍" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="RostersGrid"
                                  Grid.Column="1"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  SelectionChanged="RostersGrid_SelectionChanged" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="记分台">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="记分比赛" />
                        <ComboBox x:Name="ScoreboardMatchCombo"
                                  DisplayMemberPath="DisplayName"
                                  Width="280"
                                  SelectionChanged="ScoreboardMatchCombo_SelectionChanged" />
                    </WrapPanel>
                    <UniformGrid Grid.Row="1" Columns="4">
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="倒计时" FontSize="16" />
                                <TextBlock x:Name="TimerText" Text="10:00" FontSize="40" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="比分" FontSize="16" />
                                <TextBlock x:Name="ScoreText" Text="0 - 0" FontSize="40" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="节次" FontSize="16" />
                                <TextBlock x:Name="PeriodText" Text="第 1 节" FontSize="30" FontWeight="Bold" />
                                <TextBlock x:Name="StatusText" Text="未开始" FontSize="18" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="4">
                            <StackPanel>
                                <TextBlock Text="犯规 / 暂停" FontSize="16" />
                                <TextBlock x:Name="FoulTimeoutText" Text="0:0 / 0:0" FontSize="26" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <StackPanel Grid.Row="2" Margin="0,8">
                        <WrapPanel>
                            <Button x:Name="StartClockButton" Content="开始" Click="StartClock_Click" />
                            <Button x:Name="PauseClockButton" Content="暂停" Click="PauseClock_Click" />
                            <Button x:Name="ResumeClockButton" Content="继续" Click="StartClock_Click" />
                            <Button x:Name="ResetClockButton" Content="重置本节" Click="ResetClock_Click" />
                            <Button x:Name="NextPeriodButton" Content="下一节" Click="NextPeriod_Click" />
                            <Button x:Name="EndMatchButton" Content="结束比赛" Click="EndMatch_Click" />
                        </WrapPanel>
                        <Grid x:Name="OnCourtPanel" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock x:Name="HomeOnCourtTitle" Text="主队场上球员" FontWeight="Bold" />
                                <ListBox x:Name="HomeOnCourtList" DisplayMemberPath="DisplayName" Height="96" SelectionChanged="OnCourtPlayer_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock x:Name="AwayOnCourtTitle" Text="客队场上球员" FontWeight="Bold" />
                                <ListBox x:Name="AwayOnCourtList" DisplayMemberPath="DisplayName" Height="96" SelectionChanged="OnCourtPlayer_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="SubstitutionPanel" Margin="0,4,0,0">
                            <TextBlock x:Name="SelectedOnCourtPlayerText" Text="未选择场上球员" />
                            <TextBlock Text="换上球员" />
                            <ComboBox x:Name="SubstitutePlayerCombo" DisplayMemberPath="DisplayName" Width="220" />
                            <Button Content="替换" Click="SubstitutePlayer_Click" />
                            <TextBlock Text="事件备注" />
                            <TextBox x:Name="EventNoteBox" Width="180" />
                        </WrapPanel>
                        <WrapPanel x:Name="EventActionsPanel">
                            <Button Content="+1" Click="ScoreOne_Click" />
                            <Button Content="+2" Click="ScoreTwo_Click" />
                            <Button Content="+3" Click="ScoreThree_Click" />
                            <Button Content="犯规" Click="Foul_Click" />
                            <Button Content="篮板" Click="Rebound_Click" />
                            <Button Content="助攻" Click="Assist_Click" />
                            <Button Content="抢断" Click="Steal_Click" />
                            <Button Content="盖帽" Click="Block_Click" />
                            <Button Content="失误" Click="Turnover_Click" />
                            <Button Content="申请暂停" Click="TimeoutRequest_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="StatsGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="True"
                              IsReadOnly="True" />
                </Grid>
            </TabItem>

            <TabItem Header="比赛日志">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="作废上一条有效事件" Click="UndoLastEvent_Click" />
                        <Button Content="作废选中事件" Click="VoidSelectedEvent_Click" />
                        <TextBlock Text="作废原因" />
                        <TextBox x:Name="VoidReasonBox" Width="180" />
                        <TextBlock Text="操作人" />
                        <TextBox x:Name="VoidOperatorBox" Width="120" />
                        <Button Content="设置导出位置" Click="SetExportDirectory_Click" />
                        <Button Content="导出 CSV" Click="ExportCsv_Click" />
                        <Button Content="导出选中比赛日志 JSON" Click="ExportSelectedMatchLogs_Click" />
                        <Button Content="导入比赛日志 JSON" Click="ImportMatchLogs_Click" />
                        <TextBlock x:Name="ExportDirectoryText" Text="导出目录未设置" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="0,4,0,8">
                        <TextBlock Text="队伍筛选" />
                        <ComboBox x:Name="EventFilterSideCombo" Width="100" SelectionChanged="EventFilter_Changed" />
                        <TextBlock Text="事件筛选" />
                        <ComboBox x:Name="EventFilterKindCombo" Width="120" SelectionChanged="EventFilter_Changed" />
                        <TextBlock Text="球员筛选" />
                        <TextBox x:Name="EventPlayerFilterBox" Width="160" TextChanged="EventFilter_TextChanged" />
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="MatchesHistoryGrid"
                                  Grid.Row="0"
                                  MaxHeight="150"
                                  Margin="0,0,0,8"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="MatchesHistoryGrid_SelectionChanged"
                                  MouseDoubleClick="MatchesHistoryGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="导出" Binding="{Binding 导出, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="比赛 ID" Binding="{Binding 比赛ID}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding 创建时间}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="比赛名" Binding="{Binding 比赛名}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="主队" Binding="{Binding 主队}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="客队" Binding="{Binding 客队}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="状态" Binding="{Binding 状态}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="名单" Binding="{Binding 名单数}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="事件" Binding="{Binding 事件数}" Width="70" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="TeamStatsGrid"
                                  Grid.Row="1"
                                  MaxHeight="120"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True" />
                    <DataGrid x:Name="EventsGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="True"
                              IsReadOnly="True" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
